# Public site URL used for canonical URLs, sitemap and OG images.
# Falls back to site.url in src/config/site.ts when empty.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX).
# Analytics only loads after the visitor accepts cookies. Leave empty to disable.
NEXT_PUBLIC_GA4_ID=

# Optional chat widget script URL (e.g. a live-chat provider's loader).
# Loads only after the visitor accepts cookies. Leave empty to disable.
NEXT_PUBLIC_CHAT_WIDGET_SRC=

# Search engine verification meta tags (values from Google Search Console / Bing Webmaster Tools). Optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# IndexNow key (any 8-128 char hex string; served at /indexnow-key.txt). Used by scripts/indexnow.mjs. Optional.
INDEXNOW_KEY=
