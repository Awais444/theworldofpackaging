# Public site URL used for canonical URLs, sitemap and OG images.
# Falls back to site.url in src/config/site.ts when empty.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX).
# Analytics only loads after the visitor accepts cookies. Leave empty to disable.
NEXT_PUBLIC_GA4_ID=

# Optional chat widget script URL (e.g. a live-chat provider's loader).
# Loads only after the visitor accepts cookies. Leave empty to disable.
NEXT_PUBLIC_CHAT_WIDGET_SRC=
